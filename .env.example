# Flask Environment Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-secret-key-in-production

# Database Configuration (SQLite stored in instance/)
DATABASE_URL=sqlite:///instance/bias_detection.db

# Application Configuration
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size
ALLOW_REGISTRATION=true
